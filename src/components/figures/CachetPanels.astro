<aside class="side-panels" aria-label="Background">
  <h2>Background</h2>
  <slot />
</aside>

<script>
  // Without scripts the panels are an appendix and their links are anchors.
  // With them, the panels stay where they are in the page, so the figures
  // inside are never reconnected, and CSS stacks the open ones over the post.
  const root = document.querySelector<HTMLElement>(".side-panels");
  if (root) {
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const stack: HTMLElement[] = [];
    const panelOf = (href: string) => {
      const hash = href.slice(href.indexOf("#"));
      return panels.find(panel => `#${panel.id}` === hash) ?? null;
    };
    const render = () => {
      panels.forEach(panel => {
        const index = stack.indexOf(panel);
        panel.classList.toggle("is-open", index >= 0);
        panel.style.zIndex = String(index + 1);
        const depth = stack.length - 1 - index;
        panel.style.setProperty("--depth", String(depth));
        panel.toggleAttribute("data-behind", index >= 0 && depth > 0);
      });
      root.toggleAttribute("data-open", stack.length > 0);
      document
        .querySelectorAll<HTMLAnchorElement>('a[href^="#panel-"]')
        .forEach(link => {
          const panel = panelOf(link.getAttribute("href") ?? "");
          link.classList.toggle("is-open", !!panel && stack.includes(panel));
        });
    };
    const slideIn = (panel: HTMLElement) => {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      panel.animate(
        { transform: "translateX(100%)", offset: 0 },
        { duration: 240, easing: "cubic-bezier(0.2, 0.7, 0.3, 1)" }
      );
    };
    const open = (panel: HTMLElement, from: HTMLElement | null) => {
      if (!stack.includes(panel)) {
        const parent = from ? stack.indexOf(from) : -1;
        stack.length = parent >= 0 ? parent + 1 : 0;
        stack.push(panel);
        render();
        slideIn(panel);
      }
      panel.querySelector("h3")?.focus({ preventScroll: true });
    };
    const close = (panel: HTMLElement) => {
      stack.length = stack.indexOf(panel);
      render();
    };

    panels.forEach(panel => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "side-panel-close";
      button.textContent = "Close";
      button.setAttribute(
        "aria-label",
        `Close ${panel.querySelector("h3")?.textContent}`
      );
      button.onclick = () => close(panel);
      panel.prepend(button);
      // overscroll-behavior only holds for a panel long enough to scroll.
      const hold = (event: Event) => {
        if (panel.scrollHeight <= panel.clientHeight) event.preventDefault();
      };
      panel.addEventListener("wheel", hold, { passive: false });
      panel.addEventListener("touchmove", hold, { passive: false });
    });
    // Whatever sits behind the top panel is faded, and a click on it comes
    // back to it by closing the panel, rather than acting on what's there.
    root.addEventListener(
      "click",
      event => {
        const top = stack.at(-1);
        if (!top || top.contains(event.target as Node)) return;
        event.preventDefault();
        event.stopPropagation();
        close(top);
      },
      { capture: true }
    );
    // Transitions start once the panels are closed, or they'd all be seen
    // closing as the page loads.
    document.documentElement.dataset.panels = "";
    void root.offsetWidth;
    document.documentElement.dataset.panelsReady = "";

    document.addEventListener("click", event => {
      const link = (event.target as Element).closest?.('a[href*="#panel-"]');
      const panel = link && panelOf(link.getAttribute("href") ?? "");
      if (!link || !panel) return;
      event.preventDefault();
      open(panel, link.closest<HTMLElement>("[data-panel]"));
    });
    document.addEventListener("keydown", event => {
      const top = stack.at(-1);
      if (event.key === "Escape" && top) close(top);
    });
    const linked = panelOf(location.hash);
    if (linked) open(linked, null);
  }
</script>

<style is:global>
  .side-panels {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
  }
  html[data-panels] .side-panels {
    position: fixed;
    inset: 0;
    z-index: 30;
    margin: 0;
    border: 0;
    overflow: hidden;
    pointer-events: none;
    transition: background-color 240ms;
  }
  html[data-panels] .side-panels[data-open] {
    background: color-mix(in srgb, var(--background) 40%, transparent);
    cursor: pointer;
    pointer-events: auto;
  }
  html[data-panels] .side-panels > h2 {
    display: none;
  }
  /* Panels are cards over the post, in a row from the right: a new one
     pushes the others left, with the post still showing behind them. They
     slide in from a script, and out from here. */
  html[data-panels] .side-panel {
    display: none;
    position: absolute;
    inset: 0 0 0 auto;
    width: min(34rem, 100vw);
    box-sizing: border-box;
    padding: 1rem 1.25rem 3rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-left: 1px solid var(--border);
    background: var(--background);
    box-shadow: -8px 0 24px rgb(0 0 0 / 0.12);
    pointer-events: auto;
    transform: translateX(100%);
  }
  html[data-panels-ready] .side-panel {
    transition:
      transform 240ms cubic-bezier(0.2, 0.7, 0.3, 1),
      display 240ms allow-discrete;
  }
  html[data-panels] .side-panel.is-open {
    display: block;
    transform: translateX(calc(var(--depth, 0) * -100%));
    cursor: auto;
  }
  /* The contents fade, not the card, so the post can't show through them. */
  html[data-panels] .side-panel > * {
    transition: opacity 240ms;
  }
  html[data-panels] .side-panel[data-behind] {
    cursor: pointer;
  }
  html[data-panels] .side-panel[data-behind] > * {
    opacity: 0.6;
  }
  @media (prefers-reduced-motion: reduce) {
    html[data-panels] .side-panels,
    html[data-panels-ready] .side-panel,
    html[data-panels] .side-panel > * {
      transition: none;
    }
  }
  .side-panel-close {
    float: right;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--border);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .side-panel h3:focus {
    outline: none;
  }
  /* The mark is a small page with its right side filled in. Without scripts
     a link to a panel is an ordinary anchor, so it stays plain. */
  html[data-panels] #article a[href^="#panel-"] {
    text-decoration: underline dotted currentColor;
    text-underline-offset: 0.2em;
    cursor: e-resize;
    white-space: nowrap;
  }
  html[data-panels] #article a[href^="#panel-"]::after {
    content: "";
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    margin-left: 0.25em;
    vertical-align: -0.05em;
    border: 1.5px solid currentColor;
    border-radius: 2px;
    background: linear-gradient(to left, currentColor 40%, transparent 40%);
  }
  html[data-panels] #article a[href^="#panel-"]:hover,
  html[data-panels] #article a[href^="#panel-"].is-open {
    text-decoration-style: solid;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
</style>
