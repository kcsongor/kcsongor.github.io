---
import MatmulGrid from "./MatmulGrid.astro";
import MatrixPlayback from "./MatrixPlayback.astro";
import MatrixLegend from "./MatrixLegend.astro";

interface Props {
  // Shows one property alone, without the tabs that switch between them.
  mode?: "outputs" | "split" | "blocks";
}

const { mode } = Astro.props;
const m = 4;
const k = 6;
const n = 5;

const single = {
  outputs: {
    caption: "Computing outputs in parallel",
    intro:
      "One thread per output, all twenty at the same time. Follow one column of A and one row of B as they feed the whole result.",
  },
  split: {
    caption: "Splitting a sum across three threads",
    intro:
      "Three threads share the six products for C[1, 3]. Each builds a partial sum; the last step adds the three sums together.",
  },
  blocks: {
    caption: "A matrix of blocks",
    intro:
      "Four groups compute four output blocks. Each keeps its input blocks while their values contribute to several outputs.",
  },
};
---

<cachet-matmul-schedules
  class="gpu-figure matrix-figure not-prose"
  data-mode={mode ?? "outputs"}
  data-frame="0"
  data-m={m}
  data-n={n}
  data-k-size={k}
>
  <figure>
    <figcaption class:list={{ "sr-only": Boolean(mode) }}>
      {
        mode
          ? single[mode].caption
          : "What each property lets us run in parallel"
      }
    </figcaption>
    <p class:list={{ "figure-intro": true, "sr-only": Boolean(mode) }}>
      {
        mode
          ? single[mode].intro
          : "Outlines show the work being computed together. Blue and pink track the two halves of the sum; split sums use three colours for three partial sums. Outputs fill only as their streamed inputs arrive."
      }
    </p>
    {
      !mode && (
        <div class="matrix-chapters" role="group" aria-label="Property">
          <button type="button" data-mode-button="outputs" aria-pressed="true">
            <>
              <span class="matrix-step-number">01</span>
              <span>Independent outputs</span>
            </>
          </button>
          <button type="button" data-mode-button="split" aria-pressed="false">
            <>
              <span class="matrix-step-number">02</span>
              <span>Split sums</span>
            </>
          </button>
          <button type="button" data-mode-button="blocks" aria-pressed="false">
            <>
              <span class="matrix-step-number">03</span>
              <span>Blocks</span>
            </>
          </button>
        </div>
      )
    }
    <MatrixPlayback />
    <MatmulGrid m={m} k={k} n={n}>
      <div class="matrix-context">
        <span class="matrix-kicker" data-work-label>Working together</span>
        <strong data-work-value
          >{
            mode === "split"
              ? "3 threads"
              : mode === "blocks"
                ? "4 groups"
                : "20 threads"
          }</strong
        >
        <p data-work-unit>
          {
            mode === "split"
              ? "one output, three partial sums"
              : mode === "blocks"
                ? "one group per output block"
                : "one thread per output"
          }
        </p>
      </div>
    </MatmulGrid>
    <p class="matrix-reading schedule-caption" aria-live="polite" data-caption>
    </p>
    <MatrixLegend />
    <MatrixLegend split />
  </figure>
</cachet-matmul-schedules>

<script>
  import "./cachet-matmul.js";
</script>

<style>
  .schedule-caption {
    margin: 0.5rem 0 0;
    min-height: 4.8em;
  }
  @media (min-width: 640px) {
    .schedule-caption {
      min-height: 3.2em;
    }
  }
</style>
