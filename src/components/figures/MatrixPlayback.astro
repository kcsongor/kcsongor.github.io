<div class="matrix-playback">
  <button type="button" data-play aria-pressed="false" disabled>Play</button>
  <span class="matrix-status" data-playback-status
    >Press Play, or advance one step.</span
  >
  <div class="matrix-navigation" role="group" aria-label="Animation steps">
    <button type="button" data-step="-1" aria-label="Previous step" disabled
      >‹ Previous</button
    >
    <button type="button" data-step="1" aria-label="Next step" disabled
      >Next ›</button
    >
  </div>
</div>
